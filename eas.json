{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "apk-users": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "apk-partners": {
      "extends": "apk-users",
      "env": {
        "EXPO_PUBLIC_DISTRIBUTION": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
